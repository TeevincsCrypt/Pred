{
  "name": "pred",
  "version": "1.0.0",
  "description": "PRED \u2014 Predictive Reaction Event Detector. 24/7 market event intelligence for tokenized equities.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "start:demo": "PRED_MODE=demo node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "check:live": "node --disable-warning=ExperimentalWarning scripts/check-live.mjs",
    "check:bitget": "node examples/check-bitget.mjs",
    "demo:cli": "node examples/demo-cli.mjs"
  },
  "engines": {
    "node": ">=22.5"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.128.0"
  },
  "license": "MIT"
}
